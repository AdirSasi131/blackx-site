{
  "name": "editor-client-site",
  "version": "1.0.0",
  "private": true,
  "description": "Video editor & thumbnail designer website with client intake and private owner dashboard",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
